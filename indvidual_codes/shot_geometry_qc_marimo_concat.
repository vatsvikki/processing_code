from pathlib import Path

src = Path("/mnt/data/header_editor_marimo.py")
text = src.read_text()

insert = r'''
@app.cell(hide_code=True)
def _(mo):
    mo.md("""
    ---
    ### Concatenate two SEG-Y files

    Concatenate two compatible SEG-Y files into one `.sgy` file. The
    3200-byte text header and 400-byte binary header are copied from the
    first file; all trace records from the first and second files are then
    appended without changing their header or sample bytes.

    **Both files must have the same trace layout** (especially `ns`, sample
    format/size, and byte order). This operation does not renumber `tracl`,
    `tracr`, `fldr`, or any other trace header.
    """)
    return


@app.cell
def _(mo):
    concat_input1 = mo.ui.text(
        label="First .sgy file",
        value="",
        full_width=True,
    )
    concat_input2 = mo.ui.text(
        label="Second .sgy file",
        value="",
        full_width=True,
    )
    mo.vstack([concat_input1, concat_input2])
    return concat_input1, concat_input2


@app.cell
def _(Path, concat_input1, mo):
    _p1 = Path(concat_input1.value).expanduser() if concat_input1.value.strip() else None
    concat_output = mo.ui.text(
        label="Output .sgy file path",
        value=str(_p1.with_name(_p1.stem + "_concat.sgy")) if _p1 else "concatenated.sgy",
        full_width=True,
    )
    concat_output
    return (concat_output,)


@app.cell
def _(mo):
    concat_button = mo.ui.run_button(label="🔗 Concatenate SEG-Y files")
    concat_button
    return (concat_button,)


@app.cell
def _(
    Path,
    concat_button,
    concat_input1,
    concat_input2,
    concat_output,
    contextlib,
    mo,
    np,
    probe_info,
    reel_bytes_in,
    struct,
):
    _out = None

    def _probe_file(path):
        """Probe a SEG-Y file using the same 3600-byte reel/header assumptions as this app."""
        _size = path.stat().st_size
        with open(path, "rb") as _f:
            _f.seek(reel_bytes_in)
            _first = _f.read(HEADER_BYTES)
        if len(_first) < HEADER_BYTES:
            raise RuntimeError(
                f"File shorter than the {reel_bytes_in}-byte reel header + one trace header: {path}"
            )

        _order = None
        for _cand in (">", "<"):
            _ns = struct.unpack_from(_cand + "H", _first, NS_OFF)[0]
            if 1 <= _ns <= 20000:
                _order = _cand
                break
        if _order is None:
            raise RuntimeError(
                f"Could not determine byte order for {path}."
            )

        _ns = struct.unpack_from(_order + "H", _first, NS_OFF)[0]
        _dt = struct.unpack_from(_order + "H", _first, DT_OFF)[0]
        _trace_bytes = HEADER_BYTES + _ns * 4
        _data_bytes = _size - reel_bytes_in
        if _trace_bytes <= 0 or _data_bytes % _trace_bytes != 0:
            raise RuntimeError(
                f"{path}: file size after the {reel_bytes_in}-byte reel header "
                f"({_data_bytes:,} bytes) is not an exact multiple of trace size "
                f"{_trace_bytes:,} bytes (ns={_ns})."
            )
        return {
            "order": _order,
            "ns": _ns,
            "dt_us": _dt,
            "trace_bytes": _trace_bytes,
            "n_traces": _data_bytes // _trace_bytes,
            "file_size": _size,
        }

    def _copy_trace_records(_src, _dst, _n_traces, _trace_bytes):
        """Copy trace records in chunks so the whole SEG-Y is never loaded into RAM."""
        _remaining = _n_traces
        while _remaining > 0:
            _take = min(5000, _remaining)
            _buf = _src.read(_take * _trace_bytes)
            if len(_buf) != _take * _trace_bytes:
                raise RuntimeError(
                    f"Unexpected end of file while reading trace records "
                    f"(expected {_take * _trace_bytes:,} bytes, got {len(_buf):,})."
                )
            _dst.write(_buf)
            _remaining -= _take

    if concat_button.value:
        try:
            _p1 = Path(concat_input1.value).expanduser()
            _p2 = Path(concat_input2.value).expanduser()
            _po = Path(concat_output.value).expanduser()

            if not concat_input1.value.strip() or not concat_input2.value.strip():
                mo.stop(True, mo.callout("Enter both input SEG-Y file paths.", kind="warn"))

            if not _p1.exists():
                mo.stop(True, mo.callout(f"First input file not found: `{_p1}`", kind="danger"))
            if not _p2.exists():
                mo.stop(True, mo.callout(f"Second input file not found: `{_p2}`", kind="danger"))

            if _p1.resolve() == _po.resolve() or _p2.resolve() == _po.resolve():
                mo.stop(True, mo.callout(
                    "Output path must be different from both input files.", kind="danger"
                ))

            if _p1.resolve() == _p2.resolve():
                mo.stop(True, mo.callout(
                    "The two input files are identical. Choose two different SEG-Y files.",
                    kind="warn",
                ))

            _i1 = probe_info
            _i2 = _probe_file(_p2)

            _mismatches = []
            if _i1["ns"] != _i2["ns"]:
                _mismatches.append(f"ns: {_i1['ns']} vs {_i2['ns']}")
            if _i1["dt_us"] != _i2["dt_us"]:
                _mismatches.append(f"dt: {_i1['dt_us']} vs {_i2['dt_us']} us")
            if _i1["order"] != _i2["order"]:
                _mismatches.append(f"byte order: {_i1['order']} vs {_i2['order']}")
            if _i1["trace_bytes"] != _i2["trace_bytes"]:
                _mismatches.append(
                    f"trace size: {_i1['trace_bytes']:,} vs {_i2['trace_bytes']:,} bytes"
                )

            if _mismatches:
                mo.stop(True, mo.vstack([
                    mo.callout("The SEG-Y files are not compatible for direct concatenation.", kind="danger"),
                    mo.md("**Differences:** " + "; ".join(_mismatches)),
                ]))

            _po.parent.mkdir(parents=True, exist_ok=True)

            with mo.status.spinner(
                title=(
                    f"Concatenating {_i1['n_traces']:,} + {_i2['n_traces']:,} traces "
                    f"to {concat_output.value}..."
                )
            ):
                with contextlib.ExitStack() as _stack:
                    _f1 = _stack.enter_context(open(_p1, "rb"))
                    _f2 = _stack.enter_context(open(_p2, "rb"))
                    _fo = _stack.enter_context(open(_po, "wb"))

                    # Keep the first file's complete 3600-byte SEG-Y reel header.
                    _reel = _f1.read(reel_bytes_in)
                    if len(_reel) != reel_bytes_in:
                        raise RuntimeError("Could not read the complete first-file reel header.")
                    _fo.write(_reel)

                    _f1.seek(reel_bytes_in)
                    _f2.seek(reel_bytes_in)

                    _copy_trace_records(_f1, _fo, _i1["n_traces"], _i1["trace_bytes"])
                    _copy_trace_records(_f2, _fo, _i2["n_traces"], _i2["trace_bytes"])

            _n_total = _i1["n_traces"] + _i2["n_traces"]
            _expected_size = reel_bytes_in + _n_total * _i1["trace_bytes"]
            _actual_size = _po.stat().st_size

            _out = mo.vstack([
                mo.md(
                    f"**Done.** Concatenated **{_n_total:,} traces** "
                    f"({_i1['n_traces']:,} + {_i2['n_traces']:,}) into "
                    f"`{concat_output.value}`."
                ),
                mo.md(
                    f"Compatibility: ns={_i1['ns']}, dt={_i1['dt_us']} us, "
                    f"trace size={_i1['trace_bytes']:,} bytes, byte order=`{_i1['order']}`."
                ),
                mo.md(
                    f"QC: output size {_actual_size / 1e9:.3f} GB vs expected "
                    f"{_expected_size / 1e9:.3f} GB -- "
                    + ("**match, as expected**." if _actual_size == _expected_size
                       else "**MISMATCH -- do not use this output.**")
                ),
                mo.callout(
                    "Trace headers and sample bytes are copied unchanged. "
                    "tracl/tracr/fldr/etc. are not renumbered.",
                    kind="info",
                ),
            ])

        except Exception as _e:
            _out = mo.callout(f"Concatenation failed: {_e}", kind="danger")

    _out
    return
'''

marker = '\nif __name__ == "__main__":\n'
if marker not in text:
    raise RuntimeError("Could not find __main__ marker")

new_text = text.replace(marker, "\n" + insert + marker, 1)
out = Path("/mnt/data/header_editor_marimo_with_concat.py")
out.write_text(new_text)

print(f"Created: {out}")
print(f"Original lines: {len(text.splitlines())}")
print(f"New lines: {len(new_text.splitlines())}")
