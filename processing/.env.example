# Machine-specific settings. Copy to `.env` (next to run_app.sh) and edit; run_app.sh reads it.
# Every line is optional - anything set in the shell environment wins over this file.

# SEG-Y file the app opens at start (path on the machine that RUNS the app). Can also be typed in the page.
#SEGY_FILE=/data/raw_data/survey.sgy

# Python that has marimo + numpy + matplotlib. Empty = auto (.venv, then python3 / python on PATH,
# and if none has the packages, a project .venv is created and requirements.txt installed into it).
#PYTHON=/opt/miniconda3/bin/python

# Network: 127.0.0.1 = only this machine (reach it with an SSH tunnel);
# 0.0.0.0 = reachable from other machines (a login token is then switched on automatically).
#HOST=0.0.0.0
#PORT=2718

# Fixed password for remote access (otherwise a random token is generated at every start and printed in the URL).
#TOKEN_PASSWORD=change-me
